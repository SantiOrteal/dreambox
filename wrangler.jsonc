// Ambiente de PRODUCCIÓN: Cloudflare Workers con archivos estáticos (publica ./dist, el HTML pre-renderizado).
// No usa Workers Builds: GitHub Actions construye y despliega (.github/workflows/deploy.yml).
//  - PR a main → versión de vista previa con su propia URL (no toca producción).
//  - Merge a main → producción en dreamboxdev.mx.
// Variables de build: en GitHub (Settings → Secrets and variables → Actions). Guía completa en DEPLOY.md.
// Cabeceras HTTP: public/_headers.
{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "dreambox",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // /privacidad -> privacidad.html, /en/ -> en/index.html
    "html_handling": "auto-trailing-slash"
  },
  // Dominio de producción: Cloudflare crea los registros DNS y el certificado HTTPS al desplegar.
  // La dirección oficial es sin www. www se queda conectado para que la Redirect Rule de Cloudflare
  // lo mande a https://dreamboxdev.mx (ver DEPLOY.md).
  "routes": [
    { "pattern": "dreamboxdev.mx", "custom_domain": true },
    { "pattern": "www.dreamboxdev.mx", "custom_domain": true }
  ],
  // Dirección *.workers.dev y URLs de vista previa para cada PR.
  "workers_dev": true,
  "preview_urls": true
}
