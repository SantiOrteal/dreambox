# Plantilla de configuración. Copia este archivo como .env y llena los valores.

# Dirección pública del sitio, sin barra final: canonical, Open Graph, sitemap y schema.org.
# Mientras no haya dominio, la dirección de Netlify.
VITE_SITE_URL=https://dreamboxdev.netlify.app

# true = pide a Google no indexar el sitio (versión de prueba). Quitar al tener el dominio.
VITE_NOINDEX=true

# Formulario: access key de Web3Forms (https://web3forms.com). Es pública, no es una contraseña.
VITE_WEB3FORMS_KEY=

# Alternativa a Web3Forms: endpoint de Formspree u otro servicio. Se usa si no hay access key.
VITE_FORM_ENDPOINT=

# Opcional: ID de Google Analytics 4 (G-XXXXXXX). Solo se carga si el visitante acepta las cookies.
VITE_GA_ID=
